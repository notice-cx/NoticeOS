{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    // The repo root, not `src`: `os-time-zone.ts` imports `config/constants.json`
    // and tsc copies the specifier into the emitted JS verbatim, so rooting at
    // `src` would leave `dist` reaching outside its own tree for the JSON.
    // `scripts/contract-dist.test.mjs` fails if an emit reaches outside `dist`.
    "rootDir": "../.."
  },
  "include": ["src/**/*.ts", "src/**/*.mts"],
  "exclude": ["test/**/*.ts"]
}
