# Copy outside the public source, then set exact operator-owned values.
NOTICEOS_DEMO_IMAGE=noticeos-demo:REPLACE_WITH_FULL_SOURCE_COMMIT_SHA
NOTICEOS_DEMO_CONFIG=/absolute/path/to/private/demo.json
NOTICEOS_DEMO_HTTP_PORT=16448
# Optional: count the demo's visitors in your own Statcounter project, as
# project:security from its tracking code. Unset counts nothing.
# NOTICEOS_DEMO_STATCOUNTER=12345678:0123abcd
