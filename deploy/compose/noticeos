#!/bin/sh
# NoticeOS with Docker alone: an installation's setup and its commands, run
# from the app's published image in a short-lived container.
#
#   docker run --rm ghcr.io/notice-cx/noticeos:main launcher | sh -s -- setup
#       a new installation in ~/noticeos; setup's options follow, e.g.
#       --dir <folder>, --tower-port <n>, --offsite <folder>, --without-backup
#   ~/noticeos/noticeos <command>
#       status, logs, start, stop, restart, apply, backup, capacity, run-job,
#       update, rollback or migrate, with the options its pnpm os:* twin takes
#   ~/noticeos/noticeos mcp [--actor <name>]
#       the MCP server an agent on this machine starts, over stdio; at a
#       terminal it prints how to connect it
#   ~/noticeos/noticeos bd [--project <prefix>] <arguments>
#       the task client, in the installation's task project
#
# setup, update and migrate run main's newest published image, so the newest
# version sets up, moves and migrates the installation; every other command
# runs the image the installation's app runs; mcp and bd run inside the app
# itself, where the task client and the database are. The container reaches Docker
# through its socket and sees only the installation folder (and the offsite
# folder setup is given) at the same path as here; it writes files as you.
#
#   NOTICEOS_IMAGE           another image to run those three from (a local one included)
#   NOTICEOS_DOCKER_SOCKET   the Docker socket, when it is not /var/run/docker.sock
set -eu

repository=ghcr.io/notice-cx/noticeos
socket=${NOTICEOS_DOCKER_SOCKET:-/var/run/docker.sock}

fail() { printf 'noticeos: %s\n' "$1" >&2; exit 1; }
absolute() { case $1 in /*) printf '%s' "$1" ;; '~') printf '%s' "$HOME" ;; '~/'*) printf '%s/%s' "$HOME" "${1#'~/'}" ;; *) printf '%s/%s' "$PWD" "$1" ;; esac; }

command -v docker >/dev/null 2>&1 || fail 'Docker is not installed; install Docker Desktop or Docker Engine first.'
[ $# -gt 0 ] || fail 'name a command: setup, status, logs, start, stop, restart, apply, backup, capacity, run-job, update, rollback, migrate, mcp or bd.'
verb=$1
shift

offsite=
network=
if [ "$verb" = setup ]; then
  dir=$HOME/noticeos
  # Setup's own options pass through; the two folders are made absolute here,
  # because the container has no idea of this shell's home or working folder.
  count=$#
  while [ "$count" -gt 0 ]; do
    case $1 in
      --dir|--offsite)
        [ "$count" -ge 2 ] || fail "$1 names a folder."
        if [ "$1" = --dir ]; then dir=$2; else offsite=$2; fi
        shift 2; count=$((count - 2)) ;;
      --dir=*) dir=${1#--dir=}; shift; count=$((count - 1)) ;;
      --offsite=*) offsite=${1#--offsite=}; shift; count=$((count - 1)) ;;
      *) set -- "$@" "$1"; shift; count=$((count - 1)) ;;
    esac
  done
  dir=$(absolute "$dir")
  set -- --dir "$dir" "$@"
  if [ -n "$offsite" ]; then
    offsite=$(absolute "$offsite")
    [ -d "$offsite" ] || fail "the offsite folder $offsite does not exist; a missing sync folder is never made here."
    set -- --offsite "$offsite" "$@"
  fi
  [ -e "$dir" ] || { mkdir -p "$dir" && chmod 700 "$dir"; }
  launcher=$dir/noticeos
else
  self=$0
  if [ -L "$self" ]; then
    link=$(readlink "$self")
    case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
  fi
  dir=${NOTICEOS_DIR:-$(cd "$(dirname "$self")" && pwd -P)}
  [ -f "$dir/installation.env" ] || fail "$dir holds no installation.env; run the noticeos in your installation's folder."
  launcher=$0
  project=$(sed -n 's/^COMPOSE_PROJECT_NAME="\(.*\)"$/\1/p' "$dir/installation.env")
  [ -n "$project" ] || fail "$dir/installation.env names no project."
fi
case $dir$offsite in *,*) fail 'a folder with a comma in its path cannot be shared with Docker; choose another.' ;; esac

case $verb in
  setup|update|migrate)
    image=${NOTICEOS_IMAGE:-$repository:main}
    if [ -z "${NOTICEOS_IMAGE:-}" ] || ! docker image inspect "$image" >/dev/null 2>&1; then
      docker pull --quiet "$image" >/dev/null || fail "could not fetch $image; check the connection and that Docker is running."
    fi
    if [ "$verb" = migrate ]; then
      # Migrations reach Postgres on the installation's own network.
      network=$(docker network ls --quiet --filter "label=com.docker.compose.project=$project" --filter label=com.docker.compose.network=installation)
      [ -n "$network" ] || fail "the installation's network is missing; $launcher start brings the stack up."
    fi ;;
  status|logs|start|stop|restart|apply|backup|capacity|run-job|rollback)
    # The version the installation runs reads it; with no app container, the one installation.env names.
    app=$(docker ps --all --quiet --filter "label=com.docker.compose.project=$project" --filter label=com.docker.compose.service=noticeos)
    if [ -n "$app" ]; then image=$(docker inspect --format '{{.Image}}' "$app"); else
      image=$(sed -n 's/^NOTICEOS_APP_IMAGE="\(.*\)"$/\1/p' "$dir/installation.env"); fi
    [ -n "$image" ] || fail "neither the app nor installation.env names the installation's image." ;;
  mcp|bd)
    if [ "$verb" = mcp ] && [ -t 0 ]; then
      # An agent starts the server and talks to it over a pipe; a terminal would only wait.
      actor=claude
      [ "${1:-}" != --actor ] || [ $# -lt 2 ] || actor=$2
      printf '%s\n' 'noticeos mcp is the MCP server an agent starts itself, so at a terminal it does not run.'
      bind=$(sed -n 's/^NOTICEOS_TOWER_BIND="\(.*\)"$/\1/p' "$dir/installation.env")
      port=$(sed -n 's/^NOTICEOS_TOWER_PORT="\([0-9]*\)"$/\1/p' "$dir/installation.env")
      case ${bind:-127.0.0.1} in
        127.*) if [ -n "$port" ]; then
          printf '%s\n' 'The Tower serves the same tools on this machine:' \
            "  claude mcp add --transport http noticeos http://${bind:-127.0.0.1}:$port/api/mcp --header 'X-NoticeOS-Actor: $actor'"
          exit 0
        fi ;;
      esac
      command=$dir/noticeos
      case $command in *[!A-Za-z0-9_./-]*) command="'$command'" ;; esac
      printf '%s\n' 'Connect it to an agent:' "  claude mcp add noticeos -- $command mcp --actor $actor"
      exit 0
    fi
    app=$(docker ps --quiet --filter "label=com.docker.compose.project=$project" --filter label=com.docker.compose.service=noticeos)
    [ -n "$app" ] || fail "the app is not running; $launcher start starts it."
    # An MCP client reads plain lines; a person at a terminal gets one.
    if [ "$verb" = bd ] && [ -t 0 ] && [ -t 1 ]; then
      exec docker exec --interactive --tty "$app" node deploy/compose/entrypoint.mjs "$verb" "$@"
    fi
    exec docker exec --interactive "$app" node deploy/compose/entrypoint.mjs "$verb" "$@" ;;
  *) fail "$verb is not a command: setup, status, logs, start, stop, restart, apply, backup, capacity, run-job, update, rollback, migrate, mcp or bd." ;;
esac

set -- scripts/noticeos-cli.mjs "$verb" "$@"
set -- --entrypoint node "$image" "$@"
[ -z "$offsite" ] || set -- --mount "type=bind,source=$offsite,target=$offsite" "$@"
[ -z "$network" ] || set -- --network "$network" "$@"
if [ -t 0 ] && [ -t 1 ]; then set -- --tty "$@"; fi
exec docker run --rm --interactive --init --user 0:0 \
  --mount "type=bind,source=$socket,target=/var/run/docker.sock" \
  --mount "type=bind,source=$dir,target=$dir" \
  --env "NOTICEOS_HOST_UID=$(id -u)" --env "NOTICEOS_HOST_GID=$(id -g)" \
  --env "NOTICEOS_CLI_IMAGE=$image" --env "NOTICEOS_DIR=$dir" --env "NOTICEOS_LAUNCHER=$launcher" \
  "$@"
