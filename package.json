{
  "name": "noticeos",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "prepare": "node scripts/install-git-hooks.mjs",
    "ux:gate": "node scripts/ux-gate.mjs",
    "ux:baseline": "node scripts/ux-gate.mjs --write-baseline",
    "ux:flows": "node apps/tower/e2e/flow-gate.mjs",
    "ux:flows:baseline": "node apps/tower/e2e/flow-gate.mjs --write-baseline",
    "neutral:gate": "node scripts/neutral-code-gate.mjs",
    "os:up": "node scripts/os-up.mjs",
    "os:status": "node scripts/os-control.mjs status",
    "os:logs": "node scripts/os-control.mjs logs",
    "os:restart": "node scripts/os-control.mjs restart",
    "os:deploy": "node scripts/os-control.mjs deploy",
    "os:doctor": "node scripts/os-control.mjs doctor",
    "os:capacity": "node scripts/os-control.mjs capacity",
    "os:stop": "node scripts/os-control.mjs stop",
    "os:start": "node scripts/os-control.mjs start",
    "os:install": "node scripts/os-control.mjs install",
    "os:uninstall": "node scripts/os-control.mjs uninstall",
    "os:backup": "node scripts/os-up.mjs --backup",
    "os:cron": "node scripts/os-up.mjs --tick",
    "dev:secrets:migrate": "node scripts/dev-secrets.mjs migrate",
    "dev:secrets:sync": "node scripts/dev-secrets.mjs sync",
    "dev:secrets:import": "node scripts/dev-secrets.mjs import",
    "pulse:relay": "node scripts/pulse-relay.mjs",
    "tower:viewport-audit": "node scripts/tower-viewport-audit.mjs",
    "wall:fit": "node scripts/wall-fit-check.mjs",
    "surface:audit": "node scripts/surface-audit.mjs",
    "config:apply": "node scripts/config-apply.mjs",
    "config:seed": "node scripts/config-seed.mjs",
    "config:export": "node scripts/config-export.mjs",
    "creds:check": "node scripts/creds-check.mjs",
    "mediavine": "node scripts/mediavine.mjs",
    "creds:rotate-key": "node scripts/creds-rotate-key.mjs",
    "signals:collect": "node scripts/signal-collect.mjs",
    "signals:download": "node scripts/signal-dumps-download.mjs",
    "signals:history": "node scripts/signal-history.mjs",
    "signals:analyze-history": "node scripts/signal-history-analyze.mjs",
    "signals:refresh": "node scripts/signal-panels-refresh.mjs",
    "signals:publish-insights": "node scripts/signal-insights-publish.mjs",
    "signals:event-params": "node scripts/ga4-event-params.mjs",
    "bing-ai:import": "node scripts/bing-ai-import.mjs",
    "reclamation:import": "node scripts/reclamation-import.mjs",
    "reclamation:open-targets": "node scripts/reclamation-open-targets.mjs",
    "test:scripts": "node --import ./scripts/script-tests-setup.mjs --test-global-setup=./scripts/script-tests-global.mjs --test scripts/*.test.mjs",
    "test:task-store": "node --import ./scripts/script-tests-setup.mjs --test-global-setup=./scripts/script-tests-global.mjs --test-concurrency=1 --test scripts/hosted-task-operations-compose.test.mjs scripts/hosted-task-executor-compose.test.mjs",
    "test:journeys": "pnpm --filter @noticeos/tower run typecheck:journeys && pnpm --filter @noticeos/tower run test:journey-harness && { pnpm --filter @noticeos/tower run test:journeys; journeys=$?; pnpm --filter @noticeos/tower run test:ux-flows && exit $journeys; }",
    "postgres:dev": "node scripts/postgres-migrate.mjs",
    "postgres:migrate": "node scripts/postgres-apply.mjs",
    "postgres:consumers": "node scripts/postgres-docs.mjs --consumers",
    "postgres:secrets": "node scripts/postgres-secrets.mjs",
    "seed:local": "node scripts/db-seed.mjs",
    "config:generate": "node scripts/generate-config-contract.mjs",
    "config:check": "node scripts/generate-config-contract.mjs --check",
    "project:prepare": "node scripts/project-context.mjs",
    "stack:status": "node scripts/stack-control.mjs status",
    "stack:start": "node scripts/stack-control.mjs start",
    "stack:stop": "node scripts/stack-control.mjs stop",
    "stack:restart": "node scripts/stack-control.mjs restart",
    "stack:deploy": "node scripts/stack-deploy.mjs",
    "stack:dev": "node scripts/stack-development.mjs"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.5-r.5",
    "@types/node": "^26.1.0",
    "croner": "^10.0.1"
  }
}
