{
  "name": "noticeos",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "prepare": "node scripts/install-git-hooks.mjs",
    "generate": "node scripts/generate.mjs",
    "os:setup": "node scripts/os-setup.mjs",
    "os:convert-legacy": "node scripts/os-convert-legacy.mjs",
    "os:apply": "node scripts/stack-apply.mjs",
    "os:status": "node scripts/stack-control.mjs status",
    "os:logs": "node scripts/stack-control.mjs logs",
    "os:start": "node scripts/stack-control.mjs start",
    "os:stop": "node scripts/stack-control.mjs stop",
    "os:restart": "node scripts/stack-control.mjs restart",
    "os:restart:noticeos": "node scripts/stack-control.mjs restart noticeos",
    "os:restart:backup": "node scripts/stack-control.mjs restart backup",
    "os:restart:postgres": "node scripts/stack-control.mjs restart postgres",
    "os:restart:dolt": "node scripts/stack-control.mjs restart dolt",
    "os:update": "node scripts/stack-deploy.mjs",
    "os:rollback": "node scripts/stack-deploy.mjs --rollback",
    "os:migrate": "node scripts/os-migrate.mjs",
    "os:dev": "node scripts/stack-development.mjs",
    "os:prod": "node scripts/stack-development.mjs --disable",
    "os:backup": "node scripts/stack-control.mjs backup",
    "os:run-job": "node scripts/stack-control.mjs run-job",
    "os:collect": "node scripts/stack-control.mjs collect",
    "os:capacity": "node scripts/stack-control.mjs capacity",
    "os:refresh-anomalies": "node scripts/stack-control.mjs refresh-anomalies",
    "os:refresh-comparison": "node scripts/stack-control.mjs refresh-comparison",
    "os:mcp": "node scripts/stack-control.mjs mcp",
    "os:bd": "node scripts/stack-control.mjs bd",
    "os:codebase-report": "node scripts/codebase-report.mjs",
    "db:new-migration": "node scripts/postgres-migrate.mjs new",
    "db:try-migrations": "node scripts/postgres-migrate.mjs",
    "db:try-tower": "node scripts/start.mjs",
    "db:create-secrets": "node scripts/postgres-secrets.mjs",
    "db:seed-demo": "node scripts/db-seed.mjs",
    "db:consumers": "node scripts/postgres-docs.mjs --consumers",
    "config:apply": "node scripts/config-apply.mjs",
    "config:seed": "node scripts/config-seed.mjs",
    "config:export": "node scripts/config-export.mjs",
    "creds:check": "node scripts/creds-check.mjs",
    "creds:rotate-key": "node scripts/creds-rotate-key.mjs",
    "signals:collect": "node scripts/signal-collect.mjs",
    "signals:download": "node scripts/signal-dumps-download.mjs",
    "signals:history": "node scripts/signal-history.mjs",
    "signals:analyze-history": "node scripts/signal-history-analyze.mjs",
    "signals:refresh": "node scripts/signal-panels-refresh.mjs",
    "signals:publish-insights": "node scripts/signal-insights-publish.mjs",
    "signals:event-params": "node scripts/ga4-event-params.mjs",
    "bing-ai:import": "node scripts/bing-ai-import.mjs",
    "reclamation:import": "node scripts/reclamation-import.mjs",
    "reclamation:open-targets": "node scripts/reclamation-open-targets.mjs",
    "mediavine": "node scripts/mediavine.mjs",
    "cost:import-inference": "node scripts/inference-cost-import.mjs",
    "pulse:relay": "node scripts/pulse-relay.mjs",
    "project:prepare": "node scripts/project-context.mjs",
    "check:neutral": "node scripts/neutral-code-gate.mjs",
    "audit:copy": "node scripts/ux-gate.mjs",
    "audit:flows": "node apps/tower/e2e/flow-gate.mjs",
    "audit:viewport": "node scripts/tower-viewport-audit.mjs",
    "audit:wall-fit": "node scripts/wall-fit-check.mjs",
    "audit:surfaces": "node scripts/surface-audit.mjs",
    "test:scripts": "node --import ./scripts/script-tests-setup.mjs --test-global-setup=./scripts/script-tests-global.mjs --test scripts/*.test.mjs",
    "test:task-store": "node --import ./scripts/script-tests-setup.mjs --test-global-setup=./scripts/script-tests-global.mjs --test-concurrency=3 --test scripts/hosted-task-operations-compose.test.mjs scripts/hosted-task-executor-compose.test.mjs scripts/no-checkout-task-projects-compose.test.mjs scripts/hosted-task-snapshot-compose.test.mjs scripts/hosted-task-http-native.test.mjs scripts/hosted-demo-compose.test.mjs",
    "test:journeys": "pnpm --filter @noticeos/tower run typecheck:journeys && pnpm --filter @noticeos/tower run test:journey-harness && { pnpm --filter @noticeos/tower run test:journeys; journeys=$?; pnpm --filter @noticeos/tower run test:ux-flows && exit $journeys; }"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.5-r.5",
    "@types/node": "^26.6.5",
    "croner": "^10.0.1"
  }
}
