</line>
<line x1="15" x2="21" y1="12" y2="12">
</line>
</svg>
</span>
<span class="grid min-w-0 gap-0.5">
<span class="text-sm text-foreground break-words line-clamp-2 max-sm:line-clamp-none">July title batch</span>
<span class="text-xs text-muted-foreground max-sm:whitespace-normal max-sm:wrap-anywhere truncate">Deploy</span>
</span>
<span class="grid justify-items-end gap-0.5 text-end">
<span class="text-[13px] font-semibold tabular-nums text-foreground">1d</span>
<span class="text-[10.5px] uppercase tracking-[0.04em] text-muted-foreground">ago</span>
</span>
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 text-muted-foreground motion-safe:transition-transform" aria-hidden="true" data-row-affordance="expand">
<path d="m6 9 6 6 6-6">
</path>
</svg>
</button>
</li>
