<span data-tick="Jun 15" class="absolute top-1 whitespace-nowrap text-micro tabular-nums text-muted-foreground -translate-x-1/2" style="left: 77.454%;">Jun 15</span>
<span data-now-label="true" class="absolute top-1 whitespace-nowrap text-xs font-semibold text-foreground -translate-x-full pr-1.5" style="left: 100%;">Now</span>
</div>
</div>
</section>
<section class="flex flex-col rounded-[10px] border border-border bg-card" aria-label="Timeline">
<div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1 px-4 pb-2 pt-3">
