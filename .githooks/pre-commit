#!/bin/sh
# NoticeOS pre-commit hook. Installed by `pnpm install`: the root `prepare`
# script runs scripts/install-git-hooks.mjs, which points core.hooksPath at
# this directory.
#
# The neutral-code gate: staged product code may name none of this
# installation's own sites, asset ids or domains, and no time zone. A staged
# config document or migration rechecks every product file.
root="$(git rev-parse --show-toplevel)" || exit 1
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node is not on PATH, so the neutral-code gate cannot run. Install Node 22+ and retry." >&2
  exit 1
fi
if [ -f "$root/scripts/neutral-code-gate.mjs" ]; then
  node "$root/scripts/neutral-code-gate.mjs" --staged || exit 1
fi

# core.hooksPath replaces .git/hooks, so a repository-local pre-commit hook
# (one somebody installed before this directory existed) still runs after.
local_hook="$(git rev-parse --git-common-dir)/hooks/pre-commit"
if [ -x "$local_hook" ]; then
  exec "$local_hook" "$@"
fi
exit 0
